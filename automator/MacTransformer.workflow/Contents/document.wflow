				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># Mac Transformer Quick Action — POST each dropped file to the local
# REST server. Any output selection can be configured here; by default we
# produce all three (pdf, text, audio) using the app's default TTS engine.
PORT="${MAC_TRANSFORMER_PORT:-8771}"
OUTPUTS='["pdf","text","audio"]'
# The Quick Action defaults to writing artifacts beside the source file —
# that's what "I right-clicked this file" implies. Users can flip the app's
# global default in Settings if they'd rather the Quick Action follow that.
LAYOUT='"beside"'

for f in "$@"; do
  # Accept URLs (from Safari's share menu / drag-and-drop) as well as
  # regular file paths. URLs get downloaded to a temp file first.
  case "$f" in
    http://*|https://*)
      # Fetch the URL to a temp .html file, name it after the last path
      # segment when possible, and hand THAT to the transform.
      tmpfile=$(mktemp -t mac-transformer-share).html
      if ! curl -sSL --max-time 60 -o "$tmpfile" "$f"; then
        osascript -e "display notification \"Failed to fetch $f\" with title \"Mac Transformer\""
        continue
      fi
      f="$tmpfile"
      ;;
  esac

  # Only forward files that exist and are readable.
  if [[ ! -r "$f" ]]; then
    continue
  fi
  body=$(printf '{"path":%s,"outputs":%s,"layout":%s}' "$(printf %s "$f" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')" "$OUTPUTS" "$LAYOUT")
  curl -sf -X POST "http://127.0.0.1:$PORT/transform" \
    -H 'Content-Type: application/json' \
    -d "$body" &gt; /dev/null || {
      osascript -e "display notification \"Mac Transformer is not running (REST :$PORT). Open the app to start it.\" with title \"Mac Transformer\""
      exit 1
    }
done

osascript -e "display notification \"Queued $# file(s) for conversion.\" with title \"Mac Transformer\""
</string>
					<key>CheckedForUserDefaultShell</key>
